{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maxquill-web",
  "compatibility_date": "2026-08-28",
  "pages_build_output_dir": ".",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maxquill-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
